<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- Fail closed: even adding an engine reference must not bypass the boundary. -->
  <Target Name="EnforcePureSim" BeforeTargets="CoreCompile">
    <Error Condition="'@(ProjectReference)' != '' Or '@(PackageReference)' != ''"
           Text="SIM001: Sim must not contain project or package references." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('@(Reference)', '(?i)Godot|RtsGame'))" Text="SIM001: Engine and game assemblies are forbidden." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(Compile.FullPath)')), '\bGodot\b'))"
           Text="SIM002: Godot references are forbidden in Sim: %(Compile.Identity)" />
  </Target>
</Project>
